# sitecoder — env template (no secrets)
# Copy to .env.local for local dev. Empty = set at runtime / Zerops.

# ---- Runtime ----
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
APP_ROLE=main
NEXT_PUBLIC_SITE_URL=

# ---- Database ----
DATABASE_URL=
USE_NEON_ADAPTER=

# ---- Clerk auth ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chats
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/access

# ---- Privy Access Pass (Elysia billing on preview.useprivy.app) ----
# Use the SAME Clerk app keys as privy-dev / preview.useprivy.app
PRIVY_BILLING_ORIGIN=https://preview.useprivy.app
NEXT_PUBLIC_PRIVY_ORIGIN=https://preview.useprivy.app

# ---- Polar (legacy; optional) ----
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
NEXT_PUBLIC_POLAR_PRODUCT_ID=
POLAR_SERVER=production
POLAR_WEBHOOK_SECRET=

# ---- LLM / AI ----
TOGETHER_API_KEY=
DEFAULT_MODEL=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
HELICONE_API_KEY=
CSB_API_KEY=

# ---- Integration ----
CONTROL_PLANE_URL=
NEXT_PUBLIC_CONTROL_PLANE_URL=

# ---- Object storage ----
S3_UPLOAD_REGION=
S3_UPLOAD_BUCKET=
S3_UPLOAD_KEY=
S3_UPLOAD_SECRET=
